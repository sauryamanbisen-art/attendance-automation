# ==============================================================================
# Attendance Automation - Environment Configuration Template
# NOTE: DO NOT commit real secrets or credentials to this file or any .env file.
# Copy this file to .env and adjust local settings for your environment.
# ==============================================================================

# Core Application Settings
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
CUTOFF_TIME=16:00
DRY_RUN=true

# Database Configuration (Local SQLite by default)
DATABASE_URL=sqlite:///./attendance.db

# Portal Adapter Configuration
# Supported adapters: fake (for testing/development), or college-specific adapters
PORTAL_ADAPTER=fake
PORTAL_URL=https://portal.example.edu
PORTAL_USERNAME=demo_student
PORTAL_AUTH_MODE=password
# SENSITIVE: Never commit passwords. Kept local or in OS Keychain.
PORTAL_PASSWORD=
PORTAL_HEADLESS=true
PORTAL_TIMEOUT_MS=30000
PORTAL_STORAGE_STATE=
# Optional browser channel: set to "chrome" to use system-installed Google Chrome instead of bundled Chromium
PORTAL_BROWSER_CHANNEL=

# PWIOI Portal Adapter Settings (when PORTAL_ADAPTER=pwioi)
# PWIOI_PORTAL_URL=https://app.pwioi.club/auth/student/login
# PWIOI_ATTENDANCE_URL=https://app.pwioi.club/dashboard/student/attendance
# PWIOI_ACADEMIC_TERM=
# PWIOI_STORAGE_STATE=storage_state/pwioi_session.json
# PWIOI_BROWSER_CHANNEL=chrome

# Email / Notification Provider Configuration
# Supported providers: dry_run, gmail, google_chat
EMAIL_PROVIDER=dry_run
NOTIFICATION_SENDER_EMAIL=student@example.edu

# Gmail OAuth 2.0 Configuration (OAuth Web Application Credentials)
# Steps to obtain from Google Cloud Console (https://console.cloud.google.com/):
# 1. Enable "Gmail API" under APIs & Services > Enabled APIs & Services.
# 2. Configure OAuth Consent Screen (add test user email, scope: https://www.googleapis.com/auth/gmail.send).
# 3. Create Credentials > OAuth client ID > Application type: "Web application".
# 4. Add Authorized redirect URI: http://localhost:8000/api/auth/gmail/callback
# 5. Copy Client ID and Client Secret below (NEVER commit secrets or passwords):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Google Chat Notification Provider Configuration (OAuth 2.0)
# Provider name: google_chat
GOOGLE_CHAT_CLIENT_ID=
GOOGLE_CHAT_CLIENT_SECRET=
GOOGLE_CHAT_REDIRECT_URI=http://localhost:8000/api/auth/google-chat/callback
GOOGLE_CHAT_DEFAULT_SPACE=
GOOGLE_CHAT_TOKEN_FILE=
